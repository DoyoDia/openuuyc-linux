# Maintainer: risent <shengqi542@gmail.com>
#
# Source package tracking the Linux port's branch (DoyoDia/openuuyc-linux linux-port).
# Builds from source; expect 20-40 minutes and ~4 GB of RAM on first build.
# Template: build.yaml splits the Cargo version before invoking makepkg:
# 1.0.2-beta.6 becomes @PKGVER@=1.0.2 and @PKGREL@=6 (stable defaults to 1).

pkgname=openuuyc
_pkgname=openuuyc
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc="Third-party UU Remote client (Linux port, X11 and Wayland)"
arch=('x86_64')
url="https://github.com/DoyoDia/openuuyc-linux"
license=('custom')
depends=('gcc-libs' 'fuse3' 'libx11' 'libxcb' 'libxrandr' 'libxi' 'libxcursor'
         'libxfixes' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
         'vulkan-icd-loader' 'noto-fonts-cjk' 'gnome-keyring')
optdepends=(
    'sdl2-compat: standard gamepad forwarding and rumble'
    'libva: H.264 hardware decoding'
    'libva-nvidia-driver: NVIDIA VA-API decoding'
    'intel-media-driver: Intel VA-API decoding'
    'libpulse: desktop audio capture and playback'
    'pipewire: XDG ScreenCast capture on Wayland'
    'xdg-desktop-portal-hyprland: ScreenCast portal on Hyprland'
    'xdg-desktop-portal-gnome: ScreenCast portal on GNOME'
    'xdg-desktop-portal-kde: ScreenCast portal on KDE'
    'vulkan-swrast: software Vulkan for old GPUs and VMs'
    'ethtool: remote power-on NIC check'
    'librsvg: SVG file-type icons in host drag preview images'
)
makedepends=('cargo' 'rust' 'cmake' 'clang' 'nasm' 'pkg-config')
conflicts=('openuuyc-bin' 'openuuyc-git')
# The release profile keeps only debuginfo; nothing is left to split out.
options=('!debug')
install=openuuyc.install
source=("$pkgname::git+${url}.git#branch=linux-port")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    # Keep the build reproducible and avoid picking up a developer's local
    # cargo config; the crates.io index and git checkouts land in $srcdir.
    export CARGO_HOME="$srcdir/cargo"
    mkdir -p "$CARGO_HOME"
}

build() {
    cd "$pkgname"
    export CARGO_HOME="$srcdir/cargo"
    cargo build --release --locked --bin openuuyc
    # 虚拟显示器辅助程序是独立的 crate（自己的 workspace 与 Cargo.lock），产物落到
    # 同一个 target/，打包时只认一处。
    ( cd crates/vkms && CARGO_TARGET_DIR="$srcdir/$pkgname/target" cargo build --release --locked )
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/openuuyc "$pkgdir/usr/bin/openuuyc"
    install -Dm644 package/linux/openuuyc.desktop \
        "$pkgdir/usr/share/applications/openuuyc.desktop"
    install -Dm644 assets/icon-256.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/openuuyc.png"
    install -Dm644 package/linux/60-openuuyc-uinput.rules \
        "$pkgdir/usr/lib/udev/rules.d/60-openuuyc-uinput.rules"
    # 登录自启的被控服务。它跟着 graphical-session.target 走，所以用户要自己
    # `systemctl --user enable app-openuuyc.service`；装包时不能替用户 enable。
    install -Dm644 package/linux/app-openuuyc.service \
        "$pkgdir/usr/lib/systemd/user/app-openuuyc.service"
    install -Dm644 package/linux/openuuyc.service \
        "$pkgdir/usr/lib/systemd/user/openuuyc.service"
    # 被控端加虚拟屏要写内核 VKMS 的 configfs，只有 root 能写，所以这是另一个按需
    # 启动的系统服务：平时不跑，第一次用到时由套接字拉起（见 openuuyc.install）。
    install -Dm755 target/release/openuuyc-vkms "$pkgdir/usr/bin/openuuyc-vkms"
    install -Dm644 package/linux/openuuyc-vkms.socket \
        "$pkgdir/usr/lib/systemd/system/openuuyc-vkms.socket"
    install -Dm644 package/linux/openuuyc-vkms.service \
        "$pkgdir/usr/lib/systemd/system/openuuyc-vkms.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICES.md \
        "$pkgdir/usr/share/licenses/$pkgname/NOTICES.md"

}
